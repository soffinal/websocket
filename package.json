{
  "name": "@soffinal/websocket",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "A TypeScript WebSocket client with automatic reconnection, message queuing, and stream-based event handling",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
